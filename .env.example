NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# true uses the keys above. false uses the _DEV keys below.
PRODUCTION=false
NEXT_PUBLIC_SUPABASE_URL_DEV=https://YOUR_DEV_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=YOUR_DEV_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY_DEV=YOUR_DEV_SERVICE_ROLE_KEY
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
# Hex digest of SHA3-256 over the registration password. 64 characters. Signup is refused when this is empty or does not match.
SIGNUP_PASSWORD_HASH=
APP_VERSION=0.1.0
# Daily event reminders for the installed app. Hour is 0-23 in the timezone below.
# DAYS includes today: 3 means today, tomorrow, and the day after.
EVENT_REMINDER_HOUR=9
EVENT_REMINDER_DAYS=3
EVENT_REMINDER_TIMEZONE=Asia/Jerusalem
VAPID_SUBJECT=mailto:reminders@cnaanlist.local
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required for the hourly reminder job. Vercel sends it as Authorization: Bearer.
CRON_SECRET=
